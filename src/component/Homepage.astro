<section id="ContactForm" class="w-full h-fit">
    <div class="md:p-[10%] p-5">
        <div class="bg-gray-50/70 p-10 rounded-3xl shadow-gray-900 drop-shadow-2xl">
            <h2 class="text-center text-5xl mb-5 capitalize">Stuur <span class="lowercase">'n</span> boodskap</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <form action="" class="flex flex-col xl:px-24 py-10 gap-5">
                    <div class="flex gap-5">
                        <input type="text" placeholder="Name" class="p-3 rounded-md border-2 border-gray-900 w-1/2">
                        <input type="text" placeholder="Surname" class="p-3 rounded-md border-2 border-gray-900 w-1/2">
                    </div>
                    <input type="text" placeholder="Email" class="p-3 rounded-md border-2 border-gray-900">
                    <input type="text" placeholder="Cellphone" class="p-3 rounded-md border-2 border-gray-900">
                    <textarea placeholder="Message" class="p-3 rounded-md border-2 border-gray-900"></textarea>
                    <button class="w-1/2 mx-auto p-3 bg-transparent text-gray-900 font-semibold rounded-full text-2xl uppercase hover:bg-gray-900 border-2 hover:border-gray-50 hover:text-gray-50 border-gray-900 mt-5">Stuur</button>
                </form>
                <div class="flex flex-col place-content-center items-center h-full gap-5">
                    <div class="flex flex-col items-center">
                        <img src={phone.src} alt="" class="h-15 md:h-24">
                        <div class="text-lg lg:text-2xl text-center my-3">
                            <ul>
                                <li>
                                    Melanie Agenbag - 083 283 3617
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="flex flex-col items-center">
                        <img src={email.src} alt="" class="h-15 md:h-24">
                        <div class="text-lg lg:text-2xl text-center my-3">
                            <ul>
                                <li>info@lutzvilleskou.co.za</li>
                                <li>admin@lutzvilleskou.co.za</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>