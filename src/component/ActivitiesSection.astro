---
import ActivityCard from './ActivityCard.astro';

// Define props with default values
interface Props {
  activities?: Activity[];
}

// Define the Activity type
interface Activity {
  id: number;
  title: string;
  // description: string;
  image: string;
  buttonText?: string;
  buttonLink?: string;
  overlayText?: string;
}

// Get props with defaults
const {
  activities = []
} = Astro.props;
---

<section class="py-12 px-4 max-w-7xl mx-auto">
    <!-- Flexbox approach for better center alignment -->
    <div class="flex flex-wrap justify-center gap-6">
        {activities.map((activity) => (
        <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
            <ActivityCard 
                title={activity.title}
                image={activity.image}
                buttonText={activity.buttonText}
                buttonLink={activity.buttonLink}
                overlayText={activity.overlayText}
            />
        </div>
        ))}
    </div>
</section>