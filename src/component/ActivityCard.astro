---
// ActivityCard.astro
// Individual card component for each activity

interface Props {
  title: string;
  // description: string;
  image: string;
  buttonText?: string;
  buttonLink?: string;
  overlayText?: string;
}

const { 
  title, 
  // description, 
  image, 
  buttonText, 
  buttonLink,
  overlayText
} = Astro.props;

// Determine if we should show the button
const showButton = buttonText && buttonLink;
// Determine if we should show overlay
const showOverlay = overlayText;
---

<div class="rounded-lg overflow-hidden hover:shadow-lg transition-shadow duration-300 h-full flex flex-col">
  <!-- Image Container with fixed aspect ratio -->
  <div class="relative aspect-[3/4] w-full overflow-hidden group">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
    />
    
    <!-- Overlay - always visible when overlayText is provided -->
    {showOverlay && (
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex items-end justify-center p-6">
        <div class="bg-white/95 backdrop-blur-sm rounded-lg px-4 py-3 shadow-lg border border-white/20 transform transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl">
          <div class="text-gray-800 text-center text-sm lg:text-base font-semibold leading-relaxed" set:html={overlayText}></div>
        </div>
      </div>
    )}
  </div>
  
  <!-- Content Container -->
  <div class="p-6 flex flex-col flex-grow text-center">
    <h3 class="text-xl font-semibold mb-3">{title}</h3>
    <!-- <p class="text-gray-600 mb-4 flex-grow">{description}</p> -->
    
    {showButton && (
      <a 
        href={buttonLink} 
        target="_blank"
        class="mx-auto inline bg-gray-400 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-md transition-colors duration-300 text-center hover:shadow-md transform hover:-translate-y-1 hover:scale-105 active:translate-y-0 active:scale-100"
      >
        {buttonText}
      </a>
    )}
  </div>
</div>