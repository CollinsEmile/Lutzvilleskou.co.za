---
import BaseLayout from "../layout/BaseLayout.astro"
import activities from '../component/ACTIVITIES.js'
import ActivitiesSection from '../component/ActivitiesSection.astro'
---
<BaseLayout title="Aktiwiteite" description="By die 2025 Lutzville Landbouskou sal daar aktiwiteite wees vir iedere en elke persoon.">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
        <div class="text-center mb-8">
            <h2 class="text-3xl md:text-4xl lg:text-5xl uppercase font-georgia font-bold text-[#2C2C2C] relative inline-block after:content-[''] after:block after:w-24 after:h-1 after:bg-[#2C2C2C] after:mx-auto after:mt-3">Aktiwiteite</h2>
        </div>
        
        <div class="p-6 md:p-8 text-center">
            <p class="text-base md:text-lg text-gray-800 mb-6">
                Vermaak vir jonk en oud - dit is wat die skou in 2025 beloof! 
                <span class="block mt-2"></span>
                Pragtige perde en uitmuntende skape sal op vanjaar se skou ten toon gestel word.
                Stalletjies wat elkeen se oog sal vang, asook kindervermaak-areas, wag op jou. Daar is 'n troeteldierplaas vir die kleingoed, 'n potjiekoskompetisie vir die wat
                kan kook, 'n gholfdag vir die mans, en 'n vroueoggend vir die dames.
            </p>
            
            <p class="text-base md:text-lg font-semibold text-gray-900 mb-8">
                By die Lutzville Landboutskou 2025 is daar iets vir almal.
                <span class="block mt-1"></span>
                Kom geniet dit saam met ons!
            </p>
            
            <div class="border-t border-[#C49A3C] pt-6 mt-4">
                <p class="text-base text-gray-700 mb-6">Vir meer inligting, sien asseblief ons dagprogram sodat jy niks misloop nie.</p>
                <a href="/Dagprogram-2025-1.pdf" 
                    target="_blank" 
                    class="bg-[#C49A3C] text-white font-bold py-3 px-6 rounded-lg 
                            transition-all duration-300 ease-in-out transform 
                            hover:scale-105 hover:bg-[#B8903A] hover:shadow-lg hover:shadow-[#C49A3C]/30
                            active:scale-95 active:transition-none
                            shadow-md
                            relative overflow-hidden
                            before:absolute before:inset-0 before:bg-gradient-to-r 
                            before:from-transparent before:via-white/10 before:to-transparent
                            before:translate-x-[-100%] hover:before:translate-x-[100%]
                            before:transition-transform before:duration-700 before:ease-out">
                    Dagprogram
                </a>
            </div>
        </div>
    </div>
    <ActivitiesSection activities={activities}/>
</BaseLayout>