---
import BaseLayout from "../layout/BaseLayout.astro";
import komittee from '../images/komittee.jpg'
import Perde1 from "../images/www.lizellelotter.co.zaLutzvilleSkou2024-56.jpg";
import stalletjies6 from "../images/www.lizellelotter.co.zaLutzvilleSkou2024-99.jpg"
---
<BaseLayout title="Wie is Ons" description="Die wonderlike mense wat die skou moontlik maak vir almal om te geniet.">
    <section class="h-fit text-center">
        <div class="container mx-auto px-4 py-8 lg:py-12">
            <div class="text-center mb-6 lg:mb-8">
                <h2 class="text-2xl md:text-3xl lg:text-4xl xl:text-5xl uppercase font-bold text-[#2C2C2C] relative inline-block after:content-[''] after:block after:w-20 lg:after:w-24 after:h-1 after:bg-[#2C2C2C] after:mx-auto after:mt-3">Wie Is Ons?</h2>
            </div>
            
            <!-- Who We Are Section -->
            <div class="flex flex-col md:flex-row py-8 lg:py-12 bg-white xl:px-[8%] lg:px-[6%] md:px-[4%] px-[3%] text-center md:text-end gap-4 lg:gap-6 rounded-lg shadow-sm max-w-6xl mx-auto">
                <div class="self-center md:w-1/2 pb-4 md:pb-0">
                    <p class="text-justify leading-relaxed text-sm lg:text-base">
                        Sedert 1946 bied 'n groep toegewyde vrywilligers elke jaar hul tyd aan om die Lutzville Landbouskou te organiseer.
                        Elke jaar word daar ure se beplanning agter die skerms gedoen om 'n goed georganiseerde fees vir besoekers van alle ouderdomme aan te bied.
                    </p>
                    <p class="text-justify leading-relaxed mt-3 lg:mt-4 text-sm lg:text-base">
                        Die skou sluit vertonings van perde van heinde en verre in, asook plaaslike opkomende boere wat hul skape kom vertoon.
                    </p>
                    <p class="text-justify leading-relaxed mt-3 lg:mt-4 text-sm lg:text-base">
                        Sedert 2024 is die landbouskou 'n geregistreerde niewinsgewende organisasie (NPO), en alle fondse word herbelê in die terrein en in verskeie ondersteunende organisasies. Elke lid dra op vrywillige basis by, sonder vergoeding - gedryf deur hul passie vir die saak.
                    </p>
                    <p class="text-justify leading-relaxed mt-3 lg:mt-4 text-sm lg:text-base">
                        Hierdie toegewyde span verseker jaar na jaar die sukses van die skou.
                    </p>
                </div>
                <div class="md:w-1/2 place-content-center overflow-hidden rounded-lg">
                    <img src={stalletjies6.src} alt="Stalletjies at Lutzville Show" class="w-full h-64 md:h-80 lg:h-96 object-cover transition-transform duration-500 hover:scale-105">
                </div>
            </div>
            
            <!-- Our Mission Section -->
            <div class="flex flex-col py-12 lg:py-16 bg-gray-900 xl:px-[8%] lg:px-[6%] md:px-[4%] px-[3%] text-center md:text-start text-gray-50 mt-8 lg:mt-12 rounded-lg shadow-lg max-w-6xl mx-auto">
                <h2 class="text-2xl md:text-3xl lg:text-4xl text-yellow-500 text-center uppercase relative inline-block mx-auto after:content-[''] after:block after:w-20 lg:after:w-24 after:h-1 after:bg-yellow-500 after:mx-auto after:mt-3 mb-6 lg:mb-8">Ons Missie</h2>
                <div class="flex flex-col md:flex-row gap-4 lg:gap-6 py-4 lg:py-6">
                    <div class="md:w-1/2 place-content-center overflow-hidden rounded-lg">
                        <img src={Perde1.src} alt="Horses at Lutzville Show" class="w-full h-64 md:h-80 lg:h-96 object-cover transition-transform duration-500 hover:scale-105">
                    </div>
                    <div class="md:w-1/2 md:pb-0 md:order-2 self-center">
                        <p class="text-justify leading-relaxed text-sm lg:text-base">
                            Ons missie is om jaarliks groei en ontwikkeling te bevorder, terwyl ons steeds in ons gemeenskap belê.
                        </p>
                        <p class="text-justify leading-relaxed mt-3 lg:mt-4 text-sm lg:text-base">
                            Ons werk daaraan om 'n blywende verskil te maak deur volhoubare vooruitgang te ondersteun en plaaslike projekte en organisasies te versterk.
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Our Committee Section -->
            <div class="flex flex-col py-12 lg:py-16 xl:px-[8%] lg:px-[6%] md:px-[4%] px-[3%] text-center mt-8 lg:mt-12 bg-white rounded-lg shadow-sm max-w-6xl mx-auto">
                <h2 class="text-2xl md:text-3xl lg:text-4xl text-center uppercase relative inline-block mx-auto after:content-[''] after:block after:w-20 lg:after:w-24 after:h-1 after:bg-gray-500 after:mx-auto after:mt-3 mb-6 lg:mb-8">Ons Komitee</h2>
                <div class="flex flex-col md:flex-row gap-4 lg:gap-6 py-4 lg:py-6">
                    <div class="md:w-1/2 md:pb-0 self-center">
                        <p class="text-justify leading-relaxed text-sm lg:text-base">
                            Ons komitee bestaan uit 10 toegewyde en hardwerkende lede, elk met unieke vaardighede en talente wat hulle bydra tot die span.
                        </p>
                        <p class="text-justify leading-relaxed mt-3 lg:mt-4 text-sm lg:text-base">
                            Elke lid is sorgvuldig gekies om te verseker dat alle afdelings van die skou effektief ontwikkel en bestuur word. Die bydraes van elkeen is van groot waarde, en elke lid speel 'n sleutelrol in die sukses van ons organisasie. Ons erken en waardeer die spesifieke waarde wat elke lid tot die geheel bring, en glo dat ons kollektiewe poging die fondament van ons sukses is.
                        </p>
                    </div>
                    <div class="md:w-1/2 place-content-center overflow-hidden rounded-lg">
                        <img src={komittee.src} alt="Komitee of the Lutzville Landbouskou" class="w-full h-64 md:h-80 lg:h-96 object-cover transition-transform duration-500 hover:scale-105">
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Banner Image - Full Width -->
        <div class="w-screen relative left-1/2 right-1/2 -mx-[50vw] h-[30vh] lg:h-[40vh] aboutBanner mt-8 lg:mt-12"></div>
    </section>
</BaseLayout>