---
import BaseLayout from "../layout/BaseLayout.astro"
import PotjieField from "../images/PotjieField.jpg"
---
<BaseLayout title="Informasie" description="Informasie vir die Lutzville Landbouskou">
    <section id="info" class="xl:px-[18%] lg:px-[10%] md:px-[5%] px-5 pt-36">
        <h2 class="lg:text-6xl text-4xl md:text-center capitalize">Informasie vir die Lutzville Landbouskou</h2>
        <div class="flex flex-col lg:flex-row my-10 gap-x-5">
            <div>
                <div class="py-5">
                    <h3 class="text-3xl mb-2">Verblyf:</h3>
                    <ul class="list-inside pl-5 text-gray-600 text-lg">
                        <li>Daar is 'n kampeer area beskikbaar</li>
                        <li>Koste: Gratis</li>
                        <li>Sien asseblief kaart vir die kampeer area:</li>
                        <li class="hover:text-gray-900 hover:underline pl-5"><a href="/Kampeer Area.pdf">Kamp Kaart</a></li>
                    </ul>
                </div>
                <div class="py-5">
                    <h3 class="text-3xl mb-2">Aansoek Vorms:</h3>
                    <p class="pl-5 mb-2 text-lg">Wil jy deelneem aan die skou sien, asseblief die aansoek vorms hieronder:</p>
                    <ul class="list-inside pl-10 text-gray-600 text-lg">
                        <li class="hover:text-gray-900 hover:underline"><a href="/StalletjieAansoek.pdf">Stalletjie Aansoeke</a></li>
                        <li class="hover:text-gray-900 hover:underline"><a href="/PerdeInskrywings.pdf">Perde Skou Inskrywings</a></li>
                        <li class="hover:text-gray-900 hover:underline"><a href="/Potjiekos & Braaimaster inskrywingsvorm.pdf">Potjiekos Kompetisie</a></li>
                    </ul>
                </div>
                <div class="py-5">
                    <h3 class="text-3xl mb-2">Skedule & Algemene Inligting:</h3>
                    <ul class="list-inside pl-5 text-gray-600 text-lg">
                        <li class="hover:text-gray-900 hover:underline"><a href="/Dagprogram.pdf">Dag Program</a></li>
                        <li>Ingang Fooi: ???</li>
                        <li class="hover:text-gray-900 hover:underline"><a href="/SkouGrondKaart.jpg">Kaart na die skou gronde</a></li>
                    </ul>
                </div>
            </div>
            <div class="place-content-center p-10 border-l-2 border-gray-900">
                <img src={PotjieField.src} alt="" class="rounded-2xl">
            </div>
        </div>
    </section>
</BaseLayout>
