---
import BaseLayout from "../layout/BaseLayout.astro"
import pakkie1 from "../images/pakkie1.jpg"

---
<BaseLayout title="Skou Stalletjies" description="Die stalletjies wat op die skou gronde gaan wees, en die aansoeke om 'n stalletjie te kry">
    <section class="pt-32 text-gray-900">
        <div class="mx-[2%] sm:mx-[5%] md:mx-[10%] lg:mx-[20%] pb-16">
            <!-- <h2 class="text-5xl my-4 text-center py-5">Stalletjies</h2> -->
            <div class="flex flex-col md:flex-row gap-5 h-fit pt-5 justify-center items-center">
                <div class="md:w-1/2 rounded-xl text-center">
                    <p class="text-justify text-2xl">
                         Hierdie jaar beloof die stalletjies n verskeidenheid van handwerke, kuns en kultuur, asook die uiters gewilde landbou implemente te dek. Met natuur kindervermaak vir die jongspan.
                         <br><br>
                         Doen aansoek vir 'n stalletjie van jou eie hieronder.
                    </p>
                </div>
                <div class="hidden md:flex md:w-1/2 p-5 border-b-2 border-r-2 border-gray-900">
                    <!-- <img src={stalletjies2.src} alt="" class="">
                    <img src={vuur.src} alt="" class=""> -->
                    <img src={pakkie1.src} alt="" class="rounded-tr-3xl rounded-bl-3xl">
                </div>
            </div>     
        </div>
        <div class="w-dvw h-96 backgroundImageFixed flex items-center">
            <div class="mx-auto w-fit h-fit">
                <a href="/StalletjieAansoek.pdf" class="text-2xl md:text-4xl opacity-80 border-4 p-3 md:p-5 border-gray-900 bg-gray-50 rounded-full hover:bg-gray-900 hover:border-gray-50 hover:text-gray-100">Stalletjie Aansoek Vorms</a>
            </div>
        </div>
        
    </section>
</BaseLayout>