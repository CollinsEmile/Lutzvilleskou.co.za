---
import BaseLayout from "../layout/BaseLayout.astro"
import pakkie1 from "../images/www.lizellelotter.co.zaLutzvilleSkou2024-28.jpg"

---
<BaseLayout title="Skou Stalletjies" description="Die stalletjies wat op die skou gronde gaan wees, en die aansoeke om 'n stalletjie te kry">
    <div class="container mx-auto px-4 pt-12 max-w-4xl">
        <div class="text-center mb-8">
            <h2 class="text-3xl md:text-4xl lg:text-5xl uppercase font-georgia font-bold text-gray-900 relative inline-block after:content-[''] after:block after:w-24 after:h-1 after:bg-gray-900/50 after:mx-auto after:mt-3">Stalletjies</h2>
        </div>
        
        <div class="flex sm:flex-row flex-col gap-6 md:gap-10 items-center">
            <div class="sm:w-2/3">
                <p class="text-base md:text-lg text-gray-800 mb-6">
                    Hierdie jaar bars die stalletjies uit hul nate met 'n ongelooflike verskeidenheid handgemaakte kunswerke, kreatiewe kunsuitstallings, unieke kultuurskatte en heerlike natuur-geïnspireerde vermaak vir die jongspan!
                </p>
                
                <p class="text-base md:text-lg font-semibold text-gray-900 mt-4">
                    Droom jy daarvan om jou eie stalletjie te hê? Moenie wag nie - doen nou aansoek hieronder en wees deel van die opwinding!
                </p>
            </div>
            
            <div class="sm:w-1/3 min-h-[200px] bg-gray-200 rounded flex items-center justify-center">
                <img src={pakkie1.src} alt="Stalletjie beeld" class="max-w-full h-auto">
                <!-- Placeholder for when image is empty -->
            </div>
        </div>
        
        <div class="w-screen relative left-1/2 right-1/2 -mx-[50vw] h-96 backgroundImageFixed flex items-center mt-12">
            <div class="mx-auto w-fit h-fit">
                <a href="/StalletjieAansoek.pdf" 
                   class="inline-block text-2xl md:text-4xl opacity-80 border-4 p-3 md:p-5 border-gray-900 
                          bg-gray-50 rounded-full hover:bg-gray-900 hover:border-gray-50 
                          hover:text-white transition duration-300 ease-in-out">
                    Stalletjie Aansoek Vorms
                </a>
            </div>
        </div>
    </div>
