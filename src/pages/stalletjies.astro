---
import BaseLayout from "../layout/BaseLayout.astro"
import pakkie1 from "../images/www.lizellelotter.co.zaLutzvilleSkou2024-28.webp"
---

<BaseLayout title="Skou Stalletjies" description="Die stalletjies wat op die skou gronde gaan wees, en die aansoeke om 'n stalletjie te kry">
    <div class="container mx-auto px-4 pt-8 lg:pt-12 max-w-6xl">
        <div class="text-center mb-6 lg:mb-8">
            <h2 class="text-2xl md:text-3xl lg:text-4xl xl:text-5xl uppercase font-bold text-[#2C2C2C] relative inline-block after:content-[''] after:block after:w-20 lg:after:w-24 after:h-1 after:bg-[#2C2C2C] after:mx-auto after:mt-3">Stalletjies</h2>
        </div>
        
        <div class="flex flex-col md:flex-row gap-6 lg:gap-8 xl:gap-10 items-stretch mb-8 lg:mb-12">
            <!-- Text Content -->
            <div class="md:w-1/2 flex flex-col justify-center">
                <p class="text-sm md:text-base lg:text-lg text-gray-800 mb-4 lg:mb-6 leading-relaxed">
                    Hierdie jaar bars die stalletjies uit hul nate met 'n ongelooflike verskeidenheid handgemaakte kunswerke, kreatiewe kunsuitstallings, unieke kultuurskatte en heerlike natuur-geïnspireerde vermaak vir die jongspan!
                </p>
                
                <p class="text-sm md:text-base lg:text-lg font-semibold text-gray-900 leading-relaxed">
                    Droom jy daarvan om jou eie stalletjie te hê? Moenie wag nie - doen nou aansoek hieronder en wees deel van die opwinding!
                </p>
            </div>
            
            <!-- Image Container -->
            <div class="md:w-1/2 flex items-center justify-center">
                <div class="w-full h-full min-h-[250px] md:min-h-[200px] lg:min-h-[280px] overflow-hidden rounded-lg shadow-md">
                    <img src={pakkie1.src} 
                         alt="Stalletjie beeld" 
                         class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                </div>
            </div>
        </div>
        
        <!-- Call-to-Action Section -->
        <div class="w-screen relative left-1/2 right-1/2 -mx-[50vw] backgroundImageFixed flex items-center overflow-hidden h-[40vh]">
            <div class="mx-auto w-fit h-fit px-4">
                <a 
                   class="inline-block text-lg sm:text-xl md:text-2xl lg:text-3xl xl:text-4xl 
                          opacity-90 border-3 lg:border-4 p-3 sm:p-4 md:p-5 lg:p-6
                          border-gray-900 bg-gray-50/95 backdrop-blur-sm rounded-full 
                          hover:bg-gray-900 hover:border-gray-50 hover:text-white 
                          hover:scale-105 hover:shadow-lg hover:shadow-gray-900/20
                          active:scale-95 active:transition-none
                          transition-all duration-300 ease-in-out transform
                          font-semibold text-center whitespace-nowrap capitalize">
                          Aansoeke is gesluit
                </a>
            </div>
        </div>
    </div>
</BaseLayout>