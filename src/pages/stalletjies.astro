---
import BaseLayout from "../layout/BaseLayout.astro"
import vuur from "../images/vuur2.jpg"
import stalletjies2 from "../images/stalletjies.jpg"
import stalletjies1 from '../images/stalletjies1.jpg'
import pakkie1 from '../images/pakkie1.jpg'
import pakkie from '../images/pakkie.jpg'
import potjie from '../images/potjie.jpg'
import potjie1 from '../images/potjie1.jpg'
import potjie4 from '../images/potjie4.jpg'
import aandkuier from '../images/aandkuier.jpg'
---
<BaseLayout title="Skou Stalletjies" description="Die stalletjies wat op die skou gronde gaan wees, en die aansoeke om 'n stalletjie te kry">
    <section class="pt-32 text-gray-900">
        <div class="mx-[2%] sm:mx-[5%] md:mx-[20%] pb-16">
            <h2 class="text-5xl my-4 text-center py-5">Stalletjies</h2>
            <div class="flex gap-5 h-fit pt-5">
                <div class="w-1/2 my-20 rounded-xl text-center">
                    <p class="text-justify text-2xl">Vermaak vir jonk en oud - dit beloof die skou in 2024.  Daar is prag perde en uitmuntende skape wat ten toon gestel word op vanjaar se skou.  Stalletjies wat ieder en elk se oog sal vang, sowel as kinder vermaak areas.  Poppekas vertonings en 'n inkleur kompetisie is maar twee van die heerlike aktiwiteite wat vir u kleuter wag.  Vir die grooter kinders en die jonk van gees, daar is iets vir almal.</p>
                </div>
                <div class="hidden md:flex md:w-1/2 p-5 border-b-2 border-r-2 border-gray-900">
                    <!-- <img src={stalletjies2.src} alt="" class="">
                    <img src={vuur.src} alt="" class=""> -->
                    <img src={stalletjies1.src} alt="" class="rounded-tr-3xl rounded-bl-3xl">
                </div>  
            </div>     
        </div>
        <div class="w-dvw h-96 backgroundImageFixed flex items-center">
            <div class="mx-auto w-fit h-fit">
                <a href="/StalletjieAansoek.pdf" class="text-2xl md:text-4xl opacity-80 border-4 p-3 md:p-10 border-gray-900 bg-gray-50 rounded-full hover:bg-gray-900 hover:border-gray-50 hover:text-gray-100">Stalletjie Aansoek Vorms</a>
            </div>
        </div>
        <div class="px-[20%] py-20 flex gap-x-5 bg-gray-900">
            <div class="w-2/3 text-end place-content-center border-r-2 pr-5 border-gray-50 text-gray-50">
                <h3 class="uppercase text-5xl">kom neem deel aan die potjiekos en braaikompetisie</h3>
                <a href="/Potjiekos & Braaimaster inskrywingsvorm.pdf" class="text-xl md:text-3xl text-yellow-300 hover:underline">Skryf in!</a>
            </div>
            <div class="w-1/3">
                <a href="/Potjiekos & Braaimaster inskrywingsvorm.pdf">
                    <img src={potjie1.src} alt="" class="w-full">
                </a>
            </div>
        </div>
        <div class="bg-gray-900">
            <div class="grid grid-cols-1 md:grid-cols-3 w-full md:w-4/5 lg:w-3/5 px-3 sm:px-10 md:px-0  mx-auto py-16 gap-5">
                <div class="grid min auto-rows-min gap-5">
                    <div class="h-full w-full">
                        <img src={stalletjies1.src} alt="" class="object-cover">
                    </div>
                    <div class="h-full w-full">
                        <img src={pakkie1.src} alt="" class="object-cover">
                    </div>
                    <div class="h-full w-full">
                        <img src={aandkuier.src} alt="">
                    </div>
                </div>
                <div class="grid min auto-rows-min gap-5">
                    <div class="h-full w-full">
                        <img src={potjie.src} alt="" class="object-cover">
                    </div>
                    <div class="h-full w-full">
                        <img src={potjie1.src} alt="" class="object-cover">
                    </div>
                </div>
                <div class="grid min auto-rows-min gap-5">
                    <div class="h-full w-full">
                        <img src={potjie4.src} alt="" class="object-cover">
                    </div>
                    <div class="h-full w-full">
                        <img src={pakkie.src} alt="" class="object-cover object-center">
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>