                        <li>Ingang Fooi: R50 Volwassenes & R20 Kinders</li>
                        <li class="hover:text-gray-900 hover:underline"><a href="/SkouGrondKaart.webp">Kaart na die skou gronde</a></li>
                    </ul>
                </div>
            </div>
            <div class="place-content-center p-10 border-l-2 border-gray-900">
                <img src={PotjieField.src} alt="Festival field with a shops" class="rounded-2xl">
            </div>
        </div>
    </section> -->
</BaseLayout>
