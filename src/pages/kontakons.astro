---
import BaseLayout from "../layout/BaseLayout.astro"
import phone from '/public/Phone.png';
import email from '/public/Mail.png';
---
<BaseLayout title="Kontak Ons" description="Kry ons in die hande vir meer inligting.">
    <section id="ContactForm" class="w-full min-h-screen bg-gradient-to-b from-white to-gray-100 py-16">
        <div class="w-11/12 max-w-6xl md:p-[5%] p-5 mx-auto">
            <div class="bg-white/90 p-8 md:p-10 lg:p-12 rounded-3xl shadow-lg backdrop-blur-sm transition-all duration-300 hover:shadow-xl">
                <h2 class="text-center text-3xl md:text-4xl lg:text-5xl mb-8 font-bold text-[#2C2C2C] relative inline-block w-full after:content-[''] after:block after:w-24 after:h-1 after:bg-[#2C2C2C] after:mx-auto after:mt-3">Kontak Ons</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
                    <!-- Form Column -->
                    <form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col xl:px-12 py-6 gap-5 transition-all duration-300">
                        <input type="hidden" name="access_key" value="243f9187-450a-4f7a-bd5c-8f680df12571">
                        <div class="flex flex-col sm:flex-row gap-5">
                            <div class="w-full sm:w-1/2">
                                <!-- <label for="Naam" class="text-sm text-gray-600 ml-1 mb-1 block">Naam</label> -->
                                <input type="text" id="Naam" name="Naam" placeholder="Naam" class="p-3 rounded-md border-2 border-gray-300 w-full focus:border-gray-500 focus:outline-none transition-colors duration-200">
                            </div>
                            <div class="w-full sm:w-1/2">
                                <!-- <label for="Van" class="text-sm text-gray-600 ml-1 mb-1 block">Van</label> -->
                                <input type="text" id="Van" name="Van" placeholder="Van" class="p-3 rounded-md border-2 border-gray-300 w-full focus:border-gray-500 focus:outline-none transition-colors duration-200">
                            </div>
                        </div>
                        
                        <div>
                            <!-- <label for="Epos" class="text-sm text-gray-600 ml-1 mb-1 block">E-posadres</label> -->
                            <input type="email" id="E-pos" name="E-pos" placeholder="E-pos" class="p-3 rounded-md border-2 border-gray-300 w-full focus:border-gray-500 focus:outline-none transition-colors duration-200">
                        </div>
                        
                        <div>
                            <!-- <label for="Tel" class="text-sm text-gray-600 ml-1 mb-1 block">Selfoonnommer</label> -->
                            <input type="tel" id="Tel" name="Selfoonnommer" placeholder="Selfoonnommer" class="p-3 rounded-md border-2 border-gray-300 w-full focus:border-gray-500 focus:outline-none transition-colors duration-200">
                        </div>
                        
                        <div>
                            <!-- <label for="Boodskap" class="text-sm text-gray-600 ml-1 mb-1 block">Boodskap</label> -->
                            <textarea id="Boodskap" name="Boodskap" placeholder="Skryf u boodskap hier..." rows="5" class="p-3 rounded-md border-2 border-gray-300 w-full focus:border-gray-500 focus:outline-none transition-colors duration-200 resize-none"></textarea>
                        </div>
                        
                        <button type="submit" class="mt-4 px-8 py-3 bg-transparent text-gray-800 font-semibold rounded-full text-xl uppercase border-2 border-gray-800 hover:bg-gray-800 hover:text-white transition-all duration-300 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-opacity-50 mx-auto">
                            Stuur
                        </button>
                    </form>
                    
                    <!-- Contact Details Column -->
                    <div class="flex flex-col justify-center h-full p-5 md:p-8 bg-gray-50 rounded-2xl border border-gray-100">
                        <h3 class="text-xl md:text-2xl font-bold mb-8 text-gray-800 text-center w-full relative after:content-[''] after:block after:w-16 after:h-0.5 after:bg-gray-400 after:mx-auto after:mt-2">Kontak Besonderhede</h3>
                        
                        <div class="w-full space-y-8">
                            <!-- Phone contacts -->
                            <div>
                                <div class="p-3 w-fit mx-auto mb-4">
                                    <img src={phone.src} alt="Phone" class="h-10">
                                </div>
                                <ul class="space-y-3">
                                    <li class="text-base md:text-lg flex flex-wrap justify-center text-center">
                                        <span class="font-medium w-full sm:w-auto sm:mr-3">Louis Snyman:</span>
                                        <span>083 712 3261</span>
                                    </li>
                                    <li class="text-base md:text-lg flex flex-wrap justify-center text-center">
                                        <span class="font-medium w-full sm:w-auto sm:mr-3">Tjaart Lotter:</span>
                                        <span>076 985 0187</span>
                                    </li>
                                    <li class="text-base md:text-lg flex flex-wrap justify-center text-center">
                                        <span class="font-medium w-full sm:w-auto sm:mr-3">Melanie Agenbag:</span>
                                        <span>083 283 3617</span>
                                    </li>
                                    <li class="text-base md:text-lg flex flex-wrap justify-center text-center">
                                        <span class="font-medium w-full sm:w-auto sm:mr-3">Analéne Mouton:</span>
                                        <span>083 234 2372</span>
                                    </li>
                                </ul>
                            </div>
                            
                            <!-- Email contacts -->
                            <div>
                                <div class="p-3 w-fit mx-auto mb-4">
                                    <img src={email.src} alt="Email" class="h-6">
                                </div>
                                <ul class="space-y-3 text-center">
                                    <li class="text-base md:text-lg break-words">admin@lutzvilleskou.co.za</li>
                                    <li class="text-base md:text-lg break-words">info@lutzvilleskou.co.za</li>
                                </ul>
                            </div>
                            
                            <!-- Social Media (optional) -->
                            <!-- <div class="pt-4 mt-6 border-t border-gray-200">
                                <h4 class="text-lg font-medium mb-3 text-center">Volg Ons</h4>
                                <div class="flex justify-center space-x-4"> -->
                                    <!-- Facebook -->
                                    <!-- <a href="#" class="bg-gray-200 p-3 rounded-full transition-all duration-300 hover:bg-blue-500 hover:text-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                                        </svg>
                                    </a> -->
                                    <!-- Instagram -->
                                    <!-- <a href="#" class="bg-gray-200 p-3 rounded-full transition-all duration-300 hover:bg-pink-500 hover:text-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                                        </svg>
                                    </a> -->
                                <!-- </div> -->
                            <!-- </div> -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>