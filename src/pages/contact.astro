---
import BaseLayout from "../layout/BaseLayout.astro"
---
<BaseLayout title="Kontak Ons">
    <section class="py-32 kontakBackground">
        <div class="w-4/5 sm:w-3/5 md:w-full  lg:w-4/5 xl:w-3/5 mx-auto p-10 my-5 shadow-lg shadow-gray-800 rounded-lg bg-gray-50">
            <h2 class="text-center uppercase text-2xl py-5 font-semibold">Kontak Ons</h2>
            <div class="flex flex-col md:flex-row gap-5 justify-items-center">
                <div class="md:w-1/3 md:self-center">
                    <h3 class="text-lg py-2 font-semibold capitalize">Address</h3>
                    <ul>
                        <li>Posbus 182</li>
                        <li>Lutzville</li>
                        <li>8165</li>
                        <li>Lutzville Sportgronde</li>
                    </ul>
                </div>
                <div class="md:w-1/3 md:self-center">
                    <h3 class="text-lg py-2 font-semibold capitalize">Kontak Besonderhede</h3>
                    <ul>
                        <li>Louis Snyman - 083 712 3261</li>
                        <li>Tjaart Lotter - 076 985 0187</li>
                        <li>Melanie Agenbag - 083 283 3617</li>
                        <li>Analéne Mouton - 083 234 2372</li>
                        <li>admin@lutzvilleskou.co.za</li>
                        <li>info@lutzvilleskou.co.za</li>
                    </ul>
                </div>
                <div class="md:w-1/3 self-center h-72 w-72">
                    <a href="/SkouGrondKaart.webp"><img src="/SkouGrondKaart.webp" alt="" class="w-full h-full"></a>
                </div>
            </div>
        </div>
        <form class="flex flex-col mt-20 w-fit mx-auto p-8 lg:p-10 gap-3 shadow-lg shadow-gray-800 rounded-lg bg-gray-50">
            <label class="text-center uppercase text-xl py-5">Kom in kontak</label>
            <input type="text" id="fullname" name="fullname" placeholder="Naam & Van" class="w-full min-w-56 p-2 border-2 border-gray-500 rounded-md hover:border-gray-900">
            <input type="text" id="Tel" name="Tel" placeholder="Tel" class="w-full min-w-56 p-2 border-2 border-gray-500 rounded-md hover:border-gray-900">
            <input type="text" id="Email" name="Email" placeholder="Epos" class="w-full min-w-56 p-2 border-2 border-gray-500 rounded-md hover:border-gray-900">
            <textarea name="Message" id="Message" rows="3" placeholder="Boodskap" class="w-full min-w-56 p-2 border-2 border-gray-500 rounded-md hover:border-gray-900"></textarea>
            <button class="w-fit mx-auto border-2 rounded-3xl p-2 hover:border-gray-800">Stuur</button>  
        </form>
    </section>
</BaseLayout>